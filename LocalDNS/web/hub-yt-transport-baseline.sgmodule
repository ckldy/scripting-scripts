#!name=LocalDNS YouTube Transport Baseline
#!desc=播放安全基线：仅 YouTube 连通性与广告域名阻断，零 body 脚本。网页清洗交给 Safari AdBlockHub，客户端 protobuf 与画质增强默认关闭。
#!category=LocalDNS

[Rule]
# 拦截 QUIC (UDP 443)，迫使客户端回退 TCP；基线不 MITM YouTube，仅保证 TCP 连通
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP
# --- YouTube 媒体流直达代理（置顶防污染，杜绝频繁换源）---
DOMAIN-SUFFIX,googlevideo.com,PROXY
DOMAIN-SUFFIX,ytimg.com,PROXY
DOMAIN,youtubei.googleapis.com,PROXY
# --- YouTube 广告统计/追踪端点（模块里的 URL Rewrite 实测不生效，改走 Rule 层）---
URL-REGEX,^https?://(www|m)[.]youtube[.]com/(pagead|pcs)/,REJECT
URL-REGEX,^https?://(www|m)[.]youtube[.]com/api/stats/ads,REJECT
URL-REGEX,^https?://s[.]youtube[.]com/api/stats/ads,REJECT
AND,((DOMAIN-KEYWORD,tnc,extended-matching),(OR,((DOMAIN-SUFFIX,capcutapi.com,extended-matching),(DOMAIN-SUFFIX,zijieapi.com,extended-matching),(DOMAIN-SUFFIX,isnssdk.com,extended-matching),(DOMAIN-SUFFIX,toutiaoapi.com,extended-matching),(DOMAIN-SUFFIX,bytedance.com,extended-matching),(DOMAIN-SUFFIX,snssdk.com,extended-matching),(DOMAIN-SUFFIX,sgsnssdk.com,extended-matching)))),DIRECT
AND,((DOMAIN-KEYWORD,-ad-,extended-matching),(DOMAIN-SUFFIX,byteimg.com,extended-matching)),REJECT,pre-matching
AND,((DOMAIN-KEYWORD,ads,extended-matching),(DOMAIN-KEYWORD,-normal.zijieapi.com,extended-matching)),REJECT,pre-matching
AND,((DOMAIN-KEYWORD,adash,extended-matching),(DOMAIN-SUFFIX,ut.taobao.com,extended-matching)),REJECT,pre-matching
URL-REGEX,"^http:\/\/.+\/amdc\/mobileDispatch",REJECT,extended-matching
AND,((URL-REGEX,"^http:\/\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\/d(\d)?",extended-matching),(USER-AGENT,"*com.xunmeng.pinduoduo*")),REJECT
AND,((URL-REGEX,"^http:\/\/\[[0-9a-fA-F:]+\]\/d(\d)?\?",extended-matching),(USER-AGENT,"*com.xunmeng.pinduoduo*")),REJECT
AND,((DOMAIN,api.pinduoduo.com,extended-matching),(PROTOCOL,QUIC)),REJECT
DOMAIN,bsbsb.top,DIRECT
DOMAIN,api.biliapi.com,REJECT,pre-matching,extended-matching
DOMAIN,app.biliapi.com,REJECT,pre-matching,extended-matching
DOMAIN,api.biliapi.net,REJECT,pre-matching,extended-matching
DOMAIN,app.biliapi.net,REJECT,pre-matching,extended-matching
AND,((DOMAIN-SUFFIX,chat.bilibili.com), (OR,((DOMAIN-KEYWORD,stun), (DOMAIN-KEYWORD,tracker), (DOMAIN-KEYWORD,p2p)))),REJECT,pre-matching
DEST-PORT,4480,REJECT-NO-DROP,pre-matching
DEST-PORT,4483,REJECT-NO-DROP,pre-matching
DEST-PORT,9102,REJECT-NO-DROP,pre-matching

